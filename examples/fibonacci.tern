// Fibonacci numbers, computed recursively (i32) and iteratively (i64).

fn fib_recursive(n: i32) -> i32 {
    if n < 2 { n } else { fib_recursive(n - 1) + fib_recursive(n - 2) }
}

fn fib_iterative(n: i32) -> i64 {
    var a: i64 = 0;
    var b: i64 = 1;
    for _ in 0..n {
        let next = a + b;
        a = b;
        b = next;
    }
    a
}

export fn main() {
    print_str("recursive:");
    for i in 0..20 {
        print_str(" ");
        print_i32(fib_recursive(i));
    }
    print_str("\n");

    let samples = [10, 50, 90];
    for i in 0..3 {
        print_str("fib(");
        print_i32(samples[i]);
        print_str(") = ");
        print_i64(fib_iterative(samples[i]));
        print_str("\n");
    }
}
